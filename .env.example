# Optional Spotify app credentials (https://developer.spotify.com/dashboard).
# These can also be set on the web UI's Settings page, which overrides this file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8550/callback
# Name of the Spotify Connect device to play on (raspotify's LIBRESPOT_NAME).
SPOTIFY_DEVICE_NAME=Radio Alarm

# Hardware: "pi" (Pirate Audio display + buttons), "none" (render display to data/display.png), or "auto".
HARDWARE=auto
# Volume backend: "alsa" (amixer) or "none" (in-memory, for development). Default: alsa on Linux.
#AUDIO_BACKEND=alsa
ALSA_CONTROL=Master

SNOOZE_MINUTES=9
NORMAL_VOLUME=60
# Older Pirate Audio boards wire button Y to GPIO20 instead of GPIO24.
BUTTON_Y_PIN=24
# Dim the display backlight overnight (HH:MM, 0-100).
NIGHT_START=22:00
NIGHT_END=06:30
NIGHT_BRIGHTNESS=8
#TIMEZONE=Europe/London
