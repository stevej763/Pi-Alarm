[Unit]
Description=Radio Alarm (Spotify wake-up alarm)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target sound.target raspotify.service

[Service]
# Change "pi" to your username and the paths to where you cloned the repo.
User=pi
Group=pi
SupplementaryGroups=audio gpio spi
WorkingDirectory=/home/pi/radio-alarm
ExecStart=/home/pi/radio-alarm/.venv/bin/python -m app
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
